# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# ignore any node_modules directories (root and nested)
node_modules/
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - never commit real secrets
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local screenshot previews from add-project --dry-run
tmp-capture/
# generated site videos
site-videos/

.vercel
.env*
