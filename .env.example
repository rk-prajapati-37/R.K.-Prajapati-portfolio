# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# MongoDB Configuration
MONGODB_URI=your_mongodb_connection_string

# Email Configuration (SMTP)
# Gmail example with app-specific password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password

# Email recipient (where contact form submissions will be sent)
CONTACT_EMAIL_RECIPIENT=your_email@gmail.com

# Backend URL (for fallback contact saving)
BACKEND_URL=http://localhost:5000

# Optional: also copy every contact form submission into a Google Sheet.
# Paste the "Web app URL" from a Google Apps Script deployment (see README/setup notes).
GOOGLE_SHEETS_WEBHOOK_URL=

# ---- Automatic social feeds (see lib/socialFeeds.ts) ----
# YouTube: free API key from https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" first). Required in production — YouTube blocks
# the old public RSS feed from most server/cloud IPs, so YOUTUBE_API_KEY is needed
# for videos to actually show up on the live site.
YOUTUBE_API_KEY=
# Optional: show only this playlist on the website (get the ID from the playlist URL, starts with PL)
YOUTUBE_PLAYLIST_ID=
YOUTUBE_CHANNEL_ID=UC6ykUtYOzy11dltLkGvnmhA
# Instagram: Business/Creator account + Meta app. Long-lived user token.
INSTAGRAM_ACCESS_TOKEN=
# Facebook Page posts: Page ID + Page access token from the same Meta app.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# Instagram Business account ID linked to the Page (uses FACEBOOK_PAGE_TOKEN)
INSTAGRAM_USER_ID=

# Secret for POST /api/capture (auto-add projects from a URL)
CAPTURE_SECRET=
# Only Facebook/Instagram posts with one of these hashtags appear on the website (comma separated, without #; leave empty to show all)
SOCIAL_HASHTAGS=rkprajapati,portfolio
